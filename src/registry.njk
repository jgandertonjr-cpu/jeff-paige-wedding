---
permalink: registry.html
pageKey: registry
canonical: registry
headerDark: true
---
{#-
  Every setting on this page (photo, links, on/off switches, wording) lives
  in src/_data/registry.json, also editable at /admin → Pages → Registry.

  The registry buttons appear only when coming_soon.enabled is false AND
  amazon.url is a real link, so flipping the switch before pasting the
  registry address can never publish a broken button.
-#}
{%- extends "layouts/base.njk" -%}
{%- from "icons.njk" import icon -%}
{%- block main %}
{%- set amazon = registry.amazon -%}
{%- set fund = registry.cash_fund -%}
{%- set amazonReady = amazon.url and ("YOUR-REGISTRY-ID" not in amazon.url) -%}
{%- set showRegistry = amazonReady and not registry.coming_soon.enabled -%}
{%- set showFund = showRegistry and fund.enabled -%}
    <!-- ── PAGE HERO ── -->
    <section class="page-hero" aria-label="Page header">
      <span class="section-label">{{ registry.hero.label }}</span>
      <h1 class="page-hero__title">{{ registry.hero.title }}</h1>
      <p class="page-hero__subtitle">{{ registry.hero.subtitle }}</p>
    </section>

    <!-- ── PHOTO + REGISTRY CARD ── -->
    <section class="section registry" aria-labelledby="registry-intro">
      <div class="container">
        {%- if registry.photo %}
        {%- set size = registry.photo | imgSize %}
        <figure class="registry-photo">
          <img src="{{ registry.photo | relUrl }}" width="{{ size.width }}" height="{{ size.height }}" alt="{{ registry.photo_alt }}"{% if registry.focus and registry.focus != 'center' %} class="img-focus-{{ registry.focus }}"{% endif %}>
        </figure>
        {%- endif %}

        <div class="registry-card{% if showFund %} registry-card--wide{% endif %}{% if not registry.photo %} registry-card--flat{% endif %}">
          <div class="registry-card__intro">
            <span class="section-label">{{ registry.intro.label }}</span>
            <h2 id="registry-intro" class="registry-card__heading">{{ registry.intro.title }}</h2>
            <div class="section-ornament" aria-hidden="true"><span class="section-ornament__diamond"></span></div>
            <p class="registry-card__lead">{{ registry.intro.text }}</p>
          </div>

          {%- if showRegistry %}
          <div class="registry-options{% if showFund %} registry-options--pair{% endif %}">
            <div class="registry-option">
              <h3 class="registry-option__title">{{ amazon.title }}</h3>
              <p class="registry-option__text">{{ amazon.text }}</p>
              <a href="{{ amazon.url }}" class="btn btn--primary registry-option__cta" target="_blank" rel="noopener noreferrer">
                {{ amazon.button_text }}<span class="sr-only"> (opens in a new tab)</span>
              </a>
            </div>

            {%- if showFund %}
            <div class="registry-option">
              <h3 class="registry-option__title">{{ fund.title }}</h3>
              <p class="registry-option__text">{{ fund.text }}</p>
              {%- if fund.handles.length %}
              <dl class="registry-handles">
                {%- for handle in fund.handles %}
                <div class="registry-handles__row">
                  <dt class="registry-handles__label">{{ handle.label }}</dt>
                  <dd class="registry-handles__value">{{ handle.value }}</dd>
                </div>
                {%- endfor %}
              </dl>
              {%- endif %}
              {%- if fund.url %}
              <a href="{{ fund.url }}" class="btn btn--outline registry-option__cta" target="_blank" rel="noopener noreferrer">
                {{ fund.button_text }}<span class="sr-only"> (opens in a new tab)</span>
              </a>
              {%- endif %}
            </div>
            {%- endif %}
          </div>
          {%- else %}
          <div class="registry-options">
            <div class="registry-option registry-option--soon">
              <span class="info-badge">{{ registry.coming_soon.label }}</span>
              <h3 class="registry-option__soon-title">{{ registry.coming_soon.title }}</h3>
              <p class="registry-option__text">{{ registry.coming_soon.text }}</p>
            </div>
          </div>
          {%- endif %}
        </div>
        {%- if registry.shipping_note.enabled %}

        <p class="registry-shipping">
          {{ icon("house", 16, true) }}
          <span>{{ registry.shipping_note.text }}</span>
        </p>
        {%- endif %}
      </div>
    </section>
{% endblock %}
