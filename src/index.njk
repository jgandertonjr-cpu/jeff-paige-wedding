---
permalink: index.html
pageKey: home
canonical: ""
---
{%- extends "layouts/base.njk" -%}
{%- from "add-to-calendar.njk" import addToCalendar -%}
{%- set c = site.couple -%}
{%- set v = site.venue -%}
{#- The arch crops a wide photo to a tall frame, so the photo is drawn about twice as wide as the frame. -#}
{%- set heroSizes = "(min-width: 920px) 700px, 88vw" -%}
{%- block preload %}
  <link rel="preload" as="image" href="{{ home.hero.photo | relUrl }}" imagesrcset="{{ home.hero.photo | srcset }}" imagesizes="{{ heroSizes }}">
{%- endblock -%}
{%- block headExtra %}
  {#- Site name Google shows above the result instead of the bare domain. #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ (c.partner1_first + " & " + c.partner2_first) | dump | safe }},
    "alternateName": [{{ (c.partner1_first + " and " + c.partner2_first + "'s Wedding") | dump | safe }}, "jeffandpaige.net"],
    "url": "https://jeffandpaige.net/"
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Event",
    "name": {{ (c.partner1_first + " and " + c.partner2_first + "'s Wedding") | dump | safe }},
    "description": {{ ("The wedding of " + c.partner1_full + " and " + c.partner2_full + " at " + v.name + " in " + v.city + ", " + v.state + ".") | dump | safe }},
    "startDate": "{{ calendar.startIso }}",
    "endDate": "{{ calendar.endIso }}",
    {%- if home.hero.photo %}
    "image": ["https://jeffandpaige.net/{{ home.hero.photo | relUrl }}"],
    {%- endif %}
    "eventStatus": "https://schema.org/EventScheduled",
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "location": {
      "@type": "Place",
      "name": {{ v.name | dump | safe }},
      "address": {
        "@type": "PostalAddress",
        "streetAddress": {{ v.street | dump | safe }},
        "addressLocality": {{ v.city | dump | safe }},
        "addressRegion": {{ v.state | dump | safe }},
        "postalCode": {{ v.zip | dump | safe }},
        "addressCountry": "US"
      }
    },
    "url": "https://jeffandpaige.net",
    "organizer": [
      { "@type": "Person", "name": {{ c.partner1_full | dump | safe }}{% if c.partner1_formal and c.partner1_formal != c.partner1_full %}, "alternateName": {{ c.partner1_formal | dump | safe }}{% endif %}, "url": "https://jeffandpaige.net/" },
      { "@type": "Person", "name": {{ c.partner2_full | dump | safe }}{% if c.partner2_formal and c.partner2_formal != c.partner2_full %}, "alternateName": {{ c.partner2_formal | dump | safe }}{% endif %}, "url": "https://jeffandpaige.net/" }
    ]
  }
  </script>
{%- endblock -%}
{%- block main %}
{%- set hero = home.hero -%}
{%- set heroSize = hero.photo | imgSize %}
    <!-- ── HERO — THE INVITATION ── -->
    <section class="hero" aria-label="{{ c.partner1_first }} and {{ c.partner2_first }} are getting married">
      <div class="hero__card">
        <div class="hero__photo-wrap">
          <div class="hero__photo">
            <img src="{{ hero.photo | relUrl }}" srcset="{{ hero.photo | srcset }}" sizes="{{ heroSizes }}" width="{{ heroSize.width }}" height="{{ heroSize.height }}" alt="{{ hero.photo_alt }}" fetchpriority="high">
          </div>
        </div>
        <div class="hero__text">
          <p class="hero__eyebrow">{{ hero.eyebrow }}</p>
          <h1 class="hero__names">
            <span class="hero__name hero__name--first">{{ c.partner1_first }}</span>
            <span class="hero__and" aria-hidden="true">&amp;</span>
            <span class="sr-only">and</span>
            <span class="hero__name hero__name--second">{{ c.partner2_first }}</span>
            <span class="sr-only"> — {{ c.partner1_formal or c.partner1_full }} &amp; {{ c.partner2_formal or c.partner2_full }}</span>
          </h1>
          <div class="section-ornament" aria-hidden="true"><span class="section-ornament__diamond"></span></div>
          <p class="hero__date">{{ site.wedding_date | dateFormat('weekday') }} &middot; {{ site.wedding_date | dateFormat('long') }}</p>
          <p class="hero__location">{{ v.name }}<span class="hero__sep"> &middot; </span>{{ (v.city + ", " + v.state) | nbsp | safe }}</p>
          {#- The four things guests come for, one tap from the first screen #}
          <nav class="essentials" aria-label="Wedding essentials">
            {%- for item in nav.essentials %}
            <a href="{{ item.url }}" class="essentials__link{% if item.rsvp %} essentials__link--rsvp{% endif %}">{{ item.label }}</a>
            {%- endfor %}
          </nav>
        </div>
      </div>
    </section>

    <!-- ── WELCOME ── -->
    <section class="section" aria-labelledby="welcome-heading">
      <div class="container container--narrow text-center">
        <span class="section-label reveal">{{ home.welcome.label }}</span>
        <h2 id="welcome-heading" class="section-title reveal">{{ home.welcome.title }}</h2>
        <p class="section-subtitle drop-cap text-left mt-6 mb-8 reveal">
          {{ home.welcome.text }}
        </p>
        <a href="our-story.html" class="btn btn--ghost reveal">Our Story</a>
      </div>
    </section>

    <!-- ── COUNTDOWN — sage band, days only ── -->
    <section class="section section--dark section--sage countdown-band" aria-label="Countdown to the wedding">
      <div class="container container--narrow text-center">
        <span class="section-label reveal">{{ home.countdown.label }}</span>
        <h2 class="section-title reveal">{{ home.countdown.title }}</h2>
        <div class="countdown reveal" data-countdown aria-live="polite" aria-atomic="true">
          <span class="countdown__number" data-days>---</span>
          <span class="countdown__label">Days</span>
        </div>
      </div>
    </section>

    <!-- ── PHOTO TRIO ── -->
    <section class="section section--alt" aria-label="Photos of {{ c.partner1_first }} and {{ c.partner2_first }}">
      <div class="container">
        <div class="section-header">
          <span class="section-label reveal">{{ home.photos.label }}</span>
          <h2 class="section-title reveal reveal--delay-1">{{ home.photos.title }}</h2>
        </div>
        <div class="photo-strip">
          {%- for item in home.photos.items %}
          {%- set size = item.image | imgSize %}
          <figure class="photo-strip__item reveal{% if loop.index0 % 3 %} reveal--delay-{{ loop.index0 % 3 }}{% endif %}">
            <div class="photo-strip__frame">
              <img src="{{ item.image | relUrl }}" srcset="{{ item.image | srcset }}" sizes="(min-width: 1200px) 480px, (min-width: 700px) 42vw, 100vw" width="{{ size.width }}" height="{{ size.height }}" alt="{{ item.alt }}" loading="lazy" decoding="async"{% if item.focus and item.focus != 'center' %} class="img-focus-{{ item.focus }}"{% endif %}>
            </div>
            <figcaption class="photo-strip__caption">{{ item.caption }}</figcaption>
          </figure>
          {%- endfor %}
        </div>
        <div class="text-center mt-12">
          <a href="gallery.html" class="btn btn--outline reveal">View the Gallery</a>
        </div>
      </div>
    </section>

    <!-- ── EXPLORE — a printed index rather than icon tiles ── -->
    <section class="section" aria-labelledby="quicklinks-heading">
      <div class="container container--narrow">
        <div class="section-header">
          <span class="section-label reveal">{{ home.quick_links.label }}</span>
          <h2 id="quicklinks-heading" class="section-title reveal">{{ home.quick_links.title }}</h2>
        </div>
        <ul class="index-list reveal">
          {%- for row in [
            { "url": "our-story.html", "title": "Our Story", "desc": home.quick_links.our_story },
            { "url": "details.html", "title": "Details", "desc": home.quick_links.details },
            { "url": "rsvp.html", "title": "RSVP", "desc": home.quick_links.rsvp },
            { "url": "wedding-party.html", "title": "Wedding Party", "desc": home.quick_links.wedding_party }
          ] %}
          <li>
            <a href="{{ row.url }}" class="index-list__row">
              <span class="index-list__title">{{ row.title }}</span>
              <span class="index-list__desc">{{ row.desc }}</span>
            </a>
          </li>
          {%- endfor %}
        </ul>
      </div>
    </section>

    <!-- ── RSVP CTA BAND ── -->
    <section class="section section--alt" aria-labelledby="cta-heading">
      <div class="container container--narrow text-center">
        <span class="section-label reveal">{{ home.save_the_date.label }}</span>
        <h2 id="cta-heading" class="section-title reveal reveal--delay-1">{{ site.wedding_date | dateFormat('long') }}</h2>
        <div class="section-ornament" aria-hidden="true"><span class="section-ornament__diamond"></span></div>
        <p class="section-subtitle mb-8 reveal reveal--delay-2">
          {{ home.save_the_date.text }}
        </p>
        <div class="flex flex--center reveal reveal--delay-3">
          <a href="travel.html" class="btn btn--primary">Plan Your Trip</a>
          {{ addToCalendar(calendar) }}
        </div>
      </div>
    </section>
{% endblock %}
