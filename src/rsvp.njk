---
permalink: rsvp.html
pageKey: rsvp
canonical: rsvp
headerDark: true
---
{%- extends "layouts/base.njk" -%}
{%- block main %}

    <!-- ── PAGE HERO ── -->
    <section class="page-hero" aria-label="Page header">
      <span class="section-label">{{ rsvp.hero.label }}</span>
      <h1 class="page-hero__title">{{ rsvp.hero.title }}</h1>
      <p class="page-hero__subtitle">{{ rsvp.hero.subtitle }}</p>
    </section>

    <!-- ── FORM ── -->
    <section class="section" aria-labelledby="rsvp-form-heading">
      <div class="container container--narrow">

        <!-- Success message (hidden by default) -->
        <div class="form-success" id="rsvp-success" role="alert" aria-live="polite">
          <div class="section-ornament" aria-hidden="true"><span class="section-ornament__diamond"></span></div>
          <h2 class="form-success__title">{{ rsvp.thank_you.title }}</h2>
          <p class="text-muted measure mb-6">{{ rsvp.thank_you.text }}</p>
          <a href="details.html" class="btn btn--ghost">View Details</a>
        </div>

{%- if not rsvp.rsvp_open %}
        <!-- Save-the-date notice — shown until RSVPs open -->
        <div class="text-center">
          <div class="section-header section-header--tight">
            <span class="section-label reveal">{{ site.wedding_date | dateFormat('weekdayLong') }}</span>
            <h2 class="section-title reveal reveal--delay-1">{{ rsvp.closed_notice.title }}</h2>
            <div class="section-ornament" aria-hidden="true"><span class="section-ornament__diamond"></span></div>
            <p class="section-subtitle reveal reveal--delay-2">{{ site.venue.name }} &middot; {{ (site.venue.city + ", " + site.venue.state) | nbsp | safe }}</p>
          </div>
          <p class="text-muted measure mb-8 reveal reveal--delay-2">{{ rsvp.closed_notice.text }}</p>
          <div class="flex flex--center reveal reveal--delay-3">
            <a href="details.html" class="btn btn--primary">See the Details</a>
            <a href="travel.html" class="btn btn--outline">Plan Your Trip</a>
          </div>
          <p class="fine-print mt-6">
            Questions? Email us at <a href="mailto:{{ site.email }}">{{ site.email }}</a>
          </p>
        </div>
        {%- endif %}

        <!-- RSVP Form — always in the page so Netlify Forms can find it; hidden until RSVPs open -->
        <div id="rsvp-form-wrapper"{% if not rsvp.rsvp_open %} hidden{% endif %}>
          <div class="section-header section-header--tight">
            <span class="section-label reveal">{{ rsvp.form_intro.label }}</span>
            <h2 id="rsvp-form-heading" class="section-title reveal reveal--delay-1">{{ rsvp.form_intro.title }}</h2>
            <div class="section-ornament" aria-hidden="true"><span class="section-ornament__diamond"></span></div>
            {%- if rsvp.deadline %}
            <p class="section-subtitle">Kindly reply by {{ rsvp.deadline | dateFormat('weekdayLong') }}.</p>
            {%- endif %}
          </div>

          <form
            name="rsvp"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="form reveal reveal--delay-3"
            novalidate
          >
            <!-- Netlify hidden fields -->
            <input type="hidden" name="form-name" value="rsvp">
            <input type="hidden" name="guest_id" id="rsvp-guest-id">
            <p class="hidden" aria-hidden="true">
              <label>Don't fill this out if you're human: <input name="bot-field"></label>
            </p>

            <!-- Full Name (with guest-list autocomplete) -->
            <div class="form-group">
              <label class="form-label" for="rsvp-name">
                Full Name <span class="required" aria-hidden="true">*</span>
              </label>
              <div class="name-lookup-wrap">
                <input
                  type="text"
                  id="rsvp-name"
                  name="name"
                  class="form-input"
                  placeholder="Start typing your name…"
                  required
                  autocomplete="off"
                  role="combobox"
                  aria-autocomplete="list"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-controls="rsvp-name-listbox"
                  aria-describedby="rsvp-name-hint"
                >
                <ul id="rsvp-name-listbox" role="listbox" class="guest-suggestions" hidden aria-label="Name suggestions"></ul>
              </div>
              <p class="fine-print" id="rsvp-name-hint">Type your full name as it appears on your invitation, then choose it from the list.</p>
              <p class="fine-print" id="rsvp-lookup-nomatch" role="status" hidden>
                We can't find that name on our guest list. Try it as it appears on your invitation, or email us at <a href="mailto:{{ site.email }}">{{ site.email }}</a>.
              </p>
              <div class="rsvp-lookup-status" id="rsvp-lookup-status" hidden>
                <span class="rsvp-lookup-welcome" id="rsvp-lookup-welcome"></span>
                <button type="button" class="rsvp-lookup-reset" id="rsvp-lookup-reset">Not you?</button>
              </div>
              <span class="form-error-msg" data-error-for="rsvp-name" role="alert"></span>
            </div>

            <!-- The rest of the form appears once the guest picks their name from the guest list -->
            <div class="rsvp-details" id="rsvp-details" hidden>

            <!-- Email -->
            <div class="form-group">
              <label class="form-label" for="rsvp-email">
                Email Address <span class="required" aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                id="rsvp-email"
                name="email"
                class="form-input"
                placeholder="your@email.com"
                required
                autocomplete="email"
              >
              <span class="form-error-msg" data-error-for="rsvp-email" role="alert"></span>
            </div>

            <!-- Attending -->
            <div class="form-group">
              <fieldset class="fieldset-reset">
                <legend class="form-label">
                  Will you be attending? <span class="required" aria-hidden="true">*</span>
                </legend>
                <div class="radio-group">
                  <label class="radio-label">
                    <input type="radio" name="attending" value="yes" required>
                    Joyfully accepts
                  </label>
                  <label class="radio-label">
                    <input type="radio" name="attending" value="no">
                    Regretfully declines
                  </label>
                </div>
              </fieldset>
              <span class="form-error-msg" role="alert"></span>
            </div>

            <!-- Your Meal Choice -->
            <div class="form-group">
              <label class="form-label" for="rsvp-meal">Your Meal Preference</label>
              <select id="rsvp-meal" name="meal" class="form-select">
                <option value="" disabled selected>Select your meal choice</option>
                {%- for meal in rsvp.meal_options %}
                <option value="{{ meal.value }}">{{ meal.label }}</option>
                {%- endfor %}
              </select>
            </div>

            {%- set xq = rsvp.extra_questions or {} %}
            {%- if xq.afterparty_show %}
            <!-- After party — shown once the guest accepts (wording: admin → Pages → RSVP → Extra questions) -->
            <div class="form-group" id="rsvp-afterparty-group" hidden>
              <fieldset class="fieldset-reset" id="rsvp-afterparty" disabled>
                <legend class="form-label">
                  {{ xq.afterparty_label or "Will you join us at the after party?" }} <span class="required" aria-hidden="true">*</span>
                </legend>
                <p class="fine-print rsvp-afterparty-where">{{ afterparty.details.venue_name }}{% if afterparty.details.time_note %} · {{ afterparty.details.time_note }}{% endif %} · <a href="after-party.html">Details</a></p>
                <div class="radio-group">
                  <label class="radio-label">
                    <input type="radio" name="afterparty" value="yes">
                    Count me in
                  </label>
                  <label class="radio-label">
                    <input type="radio" name="afterparty" value="maybe">
                    Maybe
                  </label>
                  <label class="radio-label">
                    <input type="radio" name="afterparty" value="no">
                    I'll call it a night
                  </label>
                </div>
              </fieldset>
              <span class="form-error-msg" role="alert"></span>
            </div>
            {%- endif %}

            {%- if xq.wedding_song_show %}
            <!-- Wedding song for married guests — its own panel, away from the
                 dance-floor song request so the two don't get mixed up -->
            <div class="rsvp-panel" id="rsvp-wedding-song-group" hidden>
              <span class="section-label">For Married Guests</span>
              <fieldset class="fieldset-reset form-group" id="rsvp-married" disabled>
                <legend class="form-label">{{ xq.wedding_song_married_label or "Are you already married?" }}</legend>
                <div class="radio-group">
                  <label class="radio-label">
                    <input type="radio" name="married" value="yes">
                    Yes, we are
                  </label>
                  <label class="radio-label">
                    <input type="radio" name="married" value="no">
                    Not yet
                  </label>
                </div>
              </fieldset>
              <div class="form-group" id="rsvp-wedding-song-field" hidden>
                <label class="form-label" for="rsvp-wedding-song">{{ xq.wedding_song_label or "Your wedding song" }}</label>
                {%- if xq.wedding_song_hint %}
                <p class="fine-print" id="rsvp-wedding-song-hint">{{ xq.wedding_song_hint }}</p>
                {%- endif %}
                <input
                  type="text"
                  id="rsvp-wedding-song"
                  name="wedding_song"
                  class="form-input"
                  placeholder="{{ xq.wedding_song_placeholder or 'Song and artist' }}"
                  {%- if xq.wedding_song_hint %} aria-describedby="rsvp-wedding-song-hint"{% endif %}
                  disabled
                >
              </div>
            </div>
            {%- endif %}

            <!-- Plus-one section — revealed by JS when guest has entitlement -->
            <!-- Party — the other people on this guest's invitation. One block per
                 person; the guest-list lookup shows as many as the invitation has. -->
            <input type="hidden" name="party_size" id="rsvp-party-size">
            <div class="rsvp-plus-section" id="rsvp-plus-section" hidden>
              <div class="rsvp-plus-header">
                <div class="section-ornament" aria-hidden="true"><span class="section-ornament__diamond"></span></div>
                <span class="section-label" id="rsvp-plus-title">Plus-One Details</span>
                <div class="section-ornament" aria-hidden="true"><span class="section-ornament__diamond"></span></div>
              </div>
              {%- for i in range(1, (guests.guests | maxPartySize) + 1) %}

              <fieldset class="fieldset-reset rsvp-party-guest" data-party-guest="{{ i }}" hidden>
                <legend class="form-label rsvp-party-guest__title">Guest {{ i }}</legend>

                <div class="form-group">
                  <label class="form-label" for="rsvp-guest-{{ i }}-name"><span class="sr-only">Guest {{ i }} </span>Full Name</label>
                  <input
                    type="text"
                    id="rsvp-guest-{{ i }}-name"
                    name="guest_{{ i }}_name"
                    class="form-input"
                    placeholder="Guest's full name"
                    autocomplete="off"
                  >
                </div>

                <div class="form-group">
                  <label class="form-label" for="rsvp-guest-{{ i }}-attending"><span class="sr-only">Guest {{ i }} </span>Attending?</label>
                  <select id="rsvp-guest-{{ i }}-attending" name="guest_{{ i }}_attending" class="form-select">
                    <option value="yes" selected>Will attend</option>
                    <option value="no">Can't make it</option>
                  </select>
                </div>

                <div class="form-group">
                  <label class="form-label" for="rsvp-guest-{{ i }}-meal"><span class="sr-only">Guest {{ i }} </span>Meal Preference</label>
                  <select id="rsvp-guest-{{ i }}-meal" name="guest_{{ i }}_meal" class="form-select">
                    <option value="" disabled selected>Select their meal choice</option>
                    {%- for meal in rsvp.meal_options %}
                    <option value="{{ meal.value }}">{{ meal.label }}</option>
                    {%- endfor %}
                  </select>
                </div>

                {%- if xq.afterparty_show %}
                <div class="form-group" data-party-afterparty>
                  <label class="form-label" for="rsvp-guest-{{ i }}-afterparty"><span class="sr-only">Guest {{ i }} </span>Joining the After Party?</label>
                  <select id="rsvp-guest-{{ i }}-afterparty" name="guest_{{ i }}_afterparty" class="form-select">
                    <option value="" disabled selected>Select an answer</option>
                    <option value="yes">Yes, they're in</option>
                    <option value="maybe">Maybe</option>
                    <option value="no">No</option>
                  </select>
                </div>
                {%- endif %}
              </fieldset>
              {%- endfor %}
            </div>

            <!-- Dietary Restrictions -->
            <div class="form-group">
              <label class="form-label" for="rsvp-dietary">Dietary Restrictions or Allergies</label>
              <textarea
                id="rsvp-dietary"
                name="dietary_restrictions"
                class="form-textarea"
                placeholder="Please list any dietary restrictions or allergies we should know about…"
                rows="3"
              ></textarea>
            </div>

            <!-- Song Request -->
            <div class="form-group">
              <label class="form-label" for="rsvp-song">Got a song request? We'll do our best!</label>
              <input
                type="text"
                id="rsvp-song"
                name="song_request"
                class="form-input"
                placeholder="What song will get you on the dance floor?"
              >
            </div>

            <!-- Submit -->
            <div class="form-actions">
              <button type="submit" class="btn btn--rsvp">
                Send My RSVP
              </button>
              <p class="fine-print mt-4">
                Questions? Email us at <a href="mailto:{{ site.email }}">{{ site.email }}</a>
              </p>
            </div>
            </div>

          </form>
        </div>

      </div>
    </section>
{% endblock %}
{%- block scripts %}
  <script src="js/guests.js?v={{ guests | fingerprint }}" defer></script>
  <script src="js/main.js?v={{ [mainJsSource, site] | fingerprint }}" defer></script>
{%- endblock %}
