---
permalink: after-party.html
pageKey: afterparty
canonical: after-party
headerDark: true
---
{%- extends "layouts/base.njk" -%}
{%- from "icons.njk" import icon -%}
{%- block main %}
{%- set d = afterparty.details %}
    <!-- ── PAGE HERO ── -->
    <section class="page-hero" aria-label="Page header">
      <span class="section-label">{{ afterparty.hero.label }}</span>
      <h1 class="page-hero__title">{{ afterparty.hero.title }}</h1>
      <p class="page-hero__subtitle">{{ afterparty.hero.subtitle }}</p>
    </section>

    <!-- ── EVENT DETAILS ── -->
    <section class="section" aria-labelledby="afterparty-details-heading">
      <div class="container">
        <div class="section-header">
          <span class="section-label reveal">{{ d.label }}</span>
          <h2 id="afterparty-details-heading" class="section-title reveal reveal--delay-1">{{ d.title }}</h2>
          <div class="section-ornament" aria-hidden="true"><span class="section-ornament__diamond"></span></div>
        </div>

        <div class="venue-grid">

          <div class="detail-block reveal">
            <h3 class="detail-block__heading">{{ d.venue_name }}</h3>
            <div class="detail-list">
              <div class="detail-list__item">
                <span class="detail-list__label">Address</span>
                <span class="detail-list__value">{{ d.address }}
                {%- if d.map_address %}
                  <p><a href="{{ d.map_address | mapsSearchUrl }}" target="_blank" rel="noopener">Get directions</a></p>
                {%- endif %}
                </span>
              </div>
              <div class="detail-list__item">
                <span class="detail-list__label">Time</span>
                <span class="detail-list__value">{{ d.time }}
                {%- if d.time_note %}
                  <p>{{ d.time_note }}</p>
                {%- endif %}
                </span>
              </div>
              <div class="detail-list__item">
                <span class="detail-list__label">Dress Code</span>
                <span class="detail-list__value">{{ d.dress_code }}</span>
              </div>
              <div class="detail-list__item">
                <span class="detail-list__label">Open To</span>
                <span class="detail-list__value">{{ d.open_to }}</span>
              </div>
            </div>
          </div>

          <div class="reveal">
          {%- if d.map_address %}
            <div class="map-embed" data-map-src="{{ d.map_address | mapsEmbedUrl }}" data-map-title="Map of {{ d.venue_name }}">
              <button type="button" class="map-embed__load">
                {{ icon("pin", 26, true) }}
                <span class="map-embed__place">{{ d.venue_name }}</span>
                <span class="map-embed__cue">Show map</span>
              </button>
            </div>
          {%- else %}
            <div class="map-embed img-placeholder map-embed--empty" role="img" aria-label="Map placeholder — after party location TBD">
              <span class="fine-print">{{ d.map_note }}</span>
            </div>
          {%- endif %}
          </div>

        </div>
      </div>
    </section>

    <!-- ── WHAT TO EXPECT ── -->
    <section class="section section--alt" aria-labelledby="expect-heading">
      <div class="container">
        <div class="section-header">
          <span class="section-label reveal">{{ afterparty.expect.label }}</span>
          <h2 id="expect-heading" class="section-title reveal reveal--delay-1">{{ afterparty.expect.title }}</h2>
          <div class="section-ornament" aria-hidden="true"><span class="section-ornament__diamond"></span></div>
        </div>

        <div class="expect-grid">
          {%- for item in afterparty.expect.items %}
          <div class="expect-item reveal{% if loop.index0 % 4 %} reveal--delay-{{ loop.index0 % 4 }}{% endif %}">
            <div class="expect-item__icon" aria-hidden="true">
              {{ icon(item.icon, 22) }}
            </div>
            <div>
              <h3 class="expect-item__title">{{ item.title }}</h3>
              <p class="expect-item__desc">{{ item.text }}</p>
            </div>
          </div>
          {%- endfor %}
        </div>
      </div>
    </section>

    <!-- ── CTA ── -->
    <section class="section text-center" aria-label="RSVP reminder">
      <div class="container container--narrow">
        <h2 class="section-title reveal">{{ afterparty.cta.title }}</h2>
        <p class="section-subtitle mb-8 reveal reveal--delay-1">{{ afterparty.cta.text }}</p>
        <div class="flex flex--center reveal reveal--delay-2">
          <a href="details.html" class="btn btn--primary">Wedding Details</a>
        </div>
      </div>
    </section>
{% endblock %}
