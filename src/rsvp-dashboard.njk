---
permalink: admin/rsvps/index.html
eleventyExcludeFromCollections: true
---
{%- set c = site.couple -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <meta name="color-scheme" content="light">
  <title>RSVP Responses | {{ c.partner1_first }} &amp; {{ c.partner2_first }}</title>
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    /* Colors and type from DESIGN.md. Chart colors validated with the dataviz
       palette checker: --series-1 / --series-2 pass lightness, chroma, colorblind
       and normal-vision separation; --series-2 is light on white, so every value
       also has a visible label and the table. */
    :root {
      --sage: #BCCAB3; --sage-mist: #EBECE2; --ivory: #FBF8F2; --white: #FFFFFF;
      --hairline: #E4DCCA; --blush: #F3DCD5; --champagne: rgba(201, 160, 74, 0.14);
      --deep-gold: #7E5C2E; --evergreen: #243022; --deep-evergreen: #1F2A20;
      --sage-gray: #56634F; --muted-on-sage: #3E4A39;
      --series-1: #3E7B45;   /* attending / single-measure bars */
      --series-2: #C9A04A;   /* declined (brand solid gold) */
      --neutral: #DDD6C6;    /* awaiting: no answer yet */
      --grid: #EEE8DB;
      --display: "Cormorant Garamond", Georgia, serif; --body: "Jost", system-ui, sans-serif;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--ivory); color: var(--evergreen); font-family: var(--body); font-weight: 300; font-size: 16px; line-height: 1.55; }
    a { color: var(--deep-gold); }
    button { font-family: inherit; }
    .band { background: var(--sage); color: var(--deep-evergreen); padding: 28px 16px 24px; }
    .wrap { max-width: 1160px; margin: 0 auto; padding: 0 16px; }
    .band .wrap { padding: 0; }
    .eyebrow, .label { font-size: 12px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; }
    .band .eyebrow { color: var(--muted-on-sage); }
    h1 { font-family: var(--display); font-weight: 300; font-style: italic; font-size: clamp(34px, 6vw, 48px); line-height: 1.1; margin: 4px 0 8px; }
    h2 { font-family: var(--display); font-weight: 400; font-style: italic; font-size: 26px; line-height: 1.2; margin: 0; }
    .band-row { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; justify-content: space-between; }
    .meta { color: var(--muted-on-sage); font-size: 14px; }
    .actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .btn { font: 500 12px/1 var(--body); letter-spacing: 0.16em; text-transform: uppercase; border-radius: 999px; padding: 12px 18px; border: 1px solid var(--evergreen); background: var(--evergreen); color: var(--ivory); cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn--ghost { background: transparent; color: var(--evergreen); }
    .btn:disabled { opacity: 0.5; cursor: default; }
    .export-help { font-size: 13px; color: var(--muted-on-sage); width: 100%; text-align: right; }
    main.wrap { padding-top: 20px; padding-bottom: 64px; }
    .notice { background: var(--white); border: 1px solid var(--hairline); border-radius: 12px; padding: 24px; max-width: 640px; margin: 24px auto; text-align: center; }
    .notice p { margin: 8px 0 16px; color: var(--sage-gray); }
    .notice .actions { justify-content: center; }

    /* Filters: one row above everything they scope */
    .filters { position: sticky; top: 0; z-index: 5; background: var(--ivory); padding: 12px 0; margin-bottom: 8px; border-bottom: 1px solid var(--hairline); display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; }
    .seg { display: inline-flex; border: 1px solid var(--hairline); border-radius: 999px; background: var(--white); padding: 3px; }
    .seg button { border: 0; background: transparent; color: var(--evergreen); font: 400 14px var(--body); padding: 6px 12px; border-radius: 999px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
    .seg button[aria-pressed="true"] { background: var(--evergreen); color: var(--ivory); }
    .seg .key { width: 8px; height: 8px; border-radius: 2px; display: inline-block; }
    .filters select, .filters input[type=search] { font: 400 14px var(--body); padding: 8px 10px; border: 1px solid var(--hairline); border-radius: 8px; background: var(--white); color: var(--evergreen); }
    .filters input[type=search] { min-width: 200px; flex: 1; max-width: 320px; }
    .linkish { border: 0; background: none; color: var(--deep-gold); text-decoration: underline; text-underline-offset: 2px; font: 400 14px var(--body); cursor: pointer; padding: 4px 0; }
    .active-filters { font-size: 13px; color: var(--sage-gray); width: 100%; margin-top: -2px; }
    .active-filters:empty { display: none; }

    /* KPI row */
    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin: 12px 0 20px; }
    .stat { background: var(--white); border: 1px solid var(--hairline); border-radius: 12px; padding: 16px 18px; }
    .stat .label { color: var(--deep-gold); }
    .stat .num { font-family: var(--body); font-size: 40px; line-height: 1.05; font-weight: 500; margin: 8px 0 2px; }
    .stat .sub { color: var(--sage-gray); font-size: 14px; }
    .meter { height: 8px; border-radius: 4px; background: var(--sage-mist); overflow: hidden; margin-top: 10px; }
    .meter span { display: block; height: 100%; background: var(--series-1); border-radius: 0 4px 4px 0; }

    /* Cards & layout */
    .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; margin-bottom: 16px; }
    .card { background: var(--white); border: 1px solid var(--hairline); border-radius: 12px; padding: 20px; margin-bottom: 16px; min-width: 0; }
    .grid2 .card { margin-bottom: 0; }
    .card-head { display: flex; flex-wrap: wrap; gap: 4px 16px; align-items: baseline; justify-content: space-between; margin-bottom: 14px; }
    .card-head .count, .hint { color: var(--sage-gray); font-size: 14px; }
    .empty { color: var(--sage-gray); font-style: italic; margin: 4px 0; }
    .small { font-size: 14px; color: var(--sage-gray); }
    .name { font-weight: 500; }

    /* Status part-to-whole bar */
    .stack { display: flex; gap: 2px; height: 24px; margin: 6px 0 14px; }
    .stack button { border: 0; padding: 0; height: 100%; cursor: pointer; min-width: 4px; border-radius: 0; }
    .stack button:last-child { border-radius: 0 4px 4px 0; }
    .legend { display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 0; padding: 0; list-style: none; font-size: 14px; }
    .legend li { display: flex; align-items: center; gap: 8px; }
    .legend .key { width: 12px; height: 12px; border-radius: 2px; }
    .legend strong { font-weight: 500; font-variant-numeric: tabular-nums; }

    /* Horizontal bars (one measure, one color) */
    .bars { list-style: none; margin: 0; padding: 0; }
    .bars li + li { margin-top: 4px; }
    .bar { display: grid; grid-template-columns: minmax(90px, 38%) 1fr; align-items: center; gap: 12px; width: 100%; border: 0; background: transparent; text-align: left; padding: 6px 4px; border-radius: 6px; cursor: pointer; color: var(--evergreen); font: 400 15px var(--body); }
    .bar:hover, .bar:focus-visible { background: var(--sage-mist); outline: none; }
    .bar .bl { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .bar .track { display: flex; align-items: center; gap: 8px; min-width: 0; }
    .bar .fill { height: 14px; background: var(--series-1); border-radius: 0 4px 4px 0; min-width: 2px; flex: none; }
    .bar .val { font-weight: 500; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .bars.has-selection .bar:not([aria-pressed="true"]) .fill { opacity: 0.3; }
    .bar[aria-pressed="true"] { background: var(--sage-mist); }
    .bars--stacked .bar { grid-template-columns: 1fr; gap: 4px; }
    .bars--stacked .bar .bl { white-space: normal; }
    .flag { display: inline-block; font-size: 11px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; padding: 2px 8px; border-radius: 999px; background: var(--blush); color: var(--evergreen); margin-left: 6px; vertical-align: 1px; }

    /* Timeline */
    .chart { width: 100%; height: auto; display: block; overflow: visible; }
    .chart text { font-family: var(--body); font-size: 12px; fill: var(--sage-gray); }
    .chart .grid { stroke: var(--grid); stroke-width: 1; }
    .chart .line { fill: none; stroke: var(--series-1); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
    .chart .area { fill: var(--series-1); opacity: 0.1; }
    .chart .dot { fill: var(--series-1); stroke: var(--white); stroke-width: 2; }
    .chart .deadline { stroke: var(--deep-gold); stroke-width: 1; }
    .chart .cross { stroke: var(--sage-gray); stroke-width: 1; }
    .chart .end-label { fill: var(--evergreen); font-weight: 500; font-size: 13px; }
    .chart rect:focus { outline: none; }

    /* Lists & table */
    ul.plain { list-style: none; margin: 0; padding: 0; }
    ul.plain li { padding: 10px 0; border-top: 1px solid var(--hairline); }
    ul.plain li:first-child { border-top: 0; padding-top: 2px; }
    .table-wrap { overflow-x: auto; margin: 0 -20px; padding: 0 20px; }
    table { width: 100%; border-collapse: collapse; font-size: 15px; min-width: 760px; }
    th { text-align: left; font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--deep-gold); padding: 8px 10px; border-bottom: 1px solid var(--hairline); white-space: nowrap; }
    th button { all: unset; cursor: pointer; }
    th button[data-dir="asc"]::after { content: " ↑"; }
    th button[data-dir="desc"]::after { content: " ↓"; }
    td { padding: 12px 10px; border-bottom: 1px solid var(--hairline); vertical-align: top; }
    tr:last-child td { border-bottom: 0; }
    .pill { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 10px; border-radius: 999px; white-space: nowrap; background: var(--ivory); border: 1px solid var(--hairline); }
    .pill .key { width: 8px; height: 8px; border-radius: 2px; }
    .pill--warn { background: var(--champagne); color: var(--deep-gold); border-color: transparent; }
    .party { margin: 0; padding: 0; list-style: none; }
    .party .no { color: var(--sage-gray); text-decoration: line-through; }
    .party .wait { color: var(--sage-gray); }
    .tabular { font-variant-numeric: tabular-nums; }

    /* Tooltip */
    .tip { position: fixed; z-index: 20; pointer-events: none; background: var(--evergreen); color: var(--ivory); border-radius: 8px; padding: 8px 10px; font-size: 13px; line-height: 1.35; max-width: 260px; box-shadow: 0 4px 16px rgba(31, 42, 32, 0.18); }
    .tip strong { display: block; font-size: 16px; font-weight: 500; }
    .is-loading #dashboard { opacity: 0.55; transition: opacity 0.2s; }
    [hidden] { display: none !important; }
    @media (max-width: 640px) {
      .stat .num { font-size: 32px; }
      .filters { position: static; }
      .filters input[type=search] { max-width: none; width: 100%; }
      .export-help { text-align: left; }
    }
  </style>
</head>
<body>
  <header class="band">
    <div class="wrap band-row">
      <div>
        <div class="eyebrow">{{ c.partner1_first }} &amp; {{ c.partner2_first }} · {{ site.wedding_date | dateFormat('long') }}</div>
        <h1>RSVP Responses</h1>
        <div class="meta" id="meta">Loading…</div>
      </div>
      <div class="actions">
        <button class="btn" id="refresh" type="button">Refresh</button>
        <button class="btn btn--ghost" id="xlsx" type="button" disabled>Download Excel</button>
        <button class="btn btn--ghost" id="csv" type="button" disabled>CSV</button>
        <a class="btn btn--ghost" href="/admin/">Back to editor</a>
        <div class="export-help">Downloads follow your filters. Google Sheets: File → Import → Upload the Excel file.</div>
      </div>
    </div>
  </header>

  <main class="wrap">
    <div class="notice" id="signin" hidden>
      <h2>Sign in to see responses</h2>
      <p>Use the same GitHub account you use for the website editor. Only people who can edit the website can see RSVPs.</p>
      <div class="actions">
        <button class="btn" id="signin-btn" type="button">Sign in with GitHub</button>
        <a class="btn btn--ghost" href="/admin/">Open the editor</a>
      </div>
    </div>

    <div class="notice" id="error" hidden>
      <h2 id="error-title">Something went wrong</h2>
      <p id="error-text"></p>
      <div class="actions">
        <button class="btn" id="retry" type="button">Try again</button>
        <button class="btn btn--ghost" id="signout" type="button">Sign in with a different account</button>
      </div>
    </div>

    <div id="dashboard" hidden>
      <div class="filters" role="search" aria-label="Filter responses">
        <div class="seg" role="group" aria-label="Status" id="f-status">
          <button type="button" data-status="" aria-pressed="true">Everyone</button>
          <button type="button" data-status="attending" aria-pressed="false"><span class="key" style="background:var(--series-1)"></span>Attending</button>
          <button type="button" data-status="declined" aria-pressed="false"><span class="key" style="background:var(--series-2)"></span>Declined</button>
          <button type="button" data-status="awaiting" aria-pressed="false"><span class="key" style="background:var(--neutral)"></span>Awaiting</button>
        </div>
        <label class="small" for="f-meal">Meal</label>
        <select id="f-meal"><option value="">All meals</option></select>
        <label class="small" for="f-diet">Dietary</label>
        <select id="f-diet"><option value="">All</option></select>
        <input id="f-search" type="search" placeholder="Search names, emails, notes, songs…" autocomplete="off" aria-label="Search">
        <button class="linkish" id="f-clear" type="button" hidden>Clear filters</button>
        <div class="active-filters" id="active-filters" aria-live="polite"></div>
      </div>

      <section class="stats" aria-label="Totals">
        <div class="stat"><div class="label">Attending</div><div class="num" id="s-attending">–</div><div class="sub" id="s-attending-sub"></div></div>
        <div class="stat"><div class="label">Declined</div><div class="num" id="s-declined">–</div><div class="sub" id="s-declined-sub"></div></div>
        <div class="stat"><div class="label">Awaiting reply</div><div class="num" id="s-awaiting">–</div><div class="sub" id="s-awaiting-sub"></div></div>
        <div class="stat"><div class="label">After party</div><div class="num" id="s-ap">–</div><div class="sub" id="s-ap-sub"></div></div>
        <div class="stat"><div class="label">Response rate</div><div class="num" id="s-rate">–</div><div class="sub" id="s-rate-sub"></div><div class="meter" aria-hidden="true"><span id="s-rate-bar" style="width:0"></span></div></div>
      </section>

      <div class="grid2">
        <section class="card" aria-labelledby="h-status">
          <div class="card-head"><h2 id="h-status">Where replies stand</h2><span class="count" id="status-count"></span></div>
          <div class="stack" id="status-stack" role="group" aria-label="People by reply status"></div>
          <ul class="legend" id="status-legend"></ul>
          <p class="hint" style="margin:14px 0 0">Click a segment to filter.</p>
        </section>
        <section class="card" aria-labelledby="h-time">
          <div class="card-head"><h2 id="h-time">Replies over time</h2><span class="count">invitations answered</span></div>
          <div id="timeline"></div>
        </section>
      </div>

      <div class="grid2">
        <section class="card" aria-labelledby="h-meals">
          <div class="card-head"><h2 id="h-meals">Meals</h2><span class="count">people attending</span></div>
          <ul class="bars" id="meals"></ul>
        </section>
        <section class="card" aria-labelledby="h-ap">
          <div class="card-head"><h2 id="h-ap">After party</h2><span class="count">people attending</span></div>
          <ul class="bars" id="afterparty"></ul>
        </section>
      </div>

      <div class="grid2">
        <section class="card" aria-labelledby="h-diet">
          <div class="card-head"><h2 id="h-diet">Dietary needs</h2><span class="count" id="diet-count"></span></div>
          <ul class="bars" id="diet"></ul>
          <p class="hint" style="margin:12px 0 0">Grouped from what guests typed; one reply can fall in more than one group.</p>
        </section>
        <section class="card" aria-labelledby="h-songs">
          <div class="card-head"><h2 id="h-songs">Song requests</h2><span class="count" id="songs-count"></span></div>
          <ul class="bars bars--stacked" id="songs"></ul>
        </section>
      </div>

      <div class="grid2">
        <section class="card" aria-labelledby="h-waiting">
          <div class="card-head"><h2 id="h-waiting">Haven't replied yet</h2><span class="count" id="waiting-count"></span></div>
          <ul class="plain" id="waiting"></ul>
        </section>
      </div>

      <section class="card" aria-labelledby="h-table">
        <div class="card-head"><h2 id="h-table">Every invitation</h2><span class="count" id="table-count"></span></div>
        <div class="table-wrap">
          <table>
            <thead><tr>
              <th><button type="button" data-sort="name">Guest</button></th>
              <th><button type="button" data-sort="status">Reply</button></th>
              <th>Party</th>
              <th><button type="button" data-sort="meal">Meal</button></th>
              <th>Notes</th>
              <th><button type="button" data-sort="received" data-dir="desc">Received</button></th>
            </tr></thead>
            <tbody id="rows"></tbody>
          </table>
        </div>
        <p class="empty" id="rows-empty" hidden></p>
      </section>
    </div>
  </main>

  <div class="tip" id="tip" role="status" hidden></div>

  <script>
    /* Built into the page from the site's data (src/_data/guests.json, rsvp.json). */
    window.RSVP_DATA = {
      guests: {{ guests.guests | jsonScript | safe }},
      meals: {{ rsvp.meal_options | jsonScript | safe }},
      deadline: {{ (rsvp.deadline or "") | jsonScript | safe }},
      xlsxUrl: "https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js",
      xlsxIntegrity: "sha512-r22gChDnGvBylk90+2e/ycr3RVrDi8DIOkIGNhJlKfuyQM4tIRAI062MaV8sfjQKYVGjOBaZBOA87z+IhZE9DA=="
    };
  </script>
  <script>
{% raw %}
  (function () {
    'use strict';
    var DATA = window.RSVP_DATA;
    var GUESTS = DATA.guests || [];
    var MEALS = DATA.meals || [];
    var API = '/api/rsvp-responses';
    var DASH_TOKEN_KEY = 'rsvp-dashboard.github-token';
    var STATUS = {
      attending: { label: 'Attending', color: 'var(--series-1)' },
      declined: { label: 'Declined', color: 'var(--series-2)' },
      awaiting: { label: 'Awaiting', color: 'var(--neutral)' }
    };

    var $ = function (id) { return document.getElementById(id); };
    var state = { status: '', meal: '', diet: '', ap: '', q: '', sort: 'received', dir: 'desc' };
    var AFTER_PARTY = { yes: 'Joining', maybe: 'Maybe', no: 'Not joining', __none: 'No answer' };
    function apLabel(v) { return AFTER_PARTY[v || '__none'] || String(v); }
    var model = null;      // { invitations, people } from the latest load
    var view = null;       // the filtered slice, for export
    var payload = null;

    /* ── Small helpers ─────────────────────────────────────────────── */
    function norm(s) { return String(s || '').toLowerCase().trim().replace(/\s+/g, ' '); }
    function el(tag, attrs, children) {
      var node = document.createElement(tag);
      Object.keys(attrs || {}).forEach(function (k) {
        var v = attrs[k];
        if (v == null || v === false) return;
        if (k === 'text') node.textContent = v;
        else if (k === 'className') node.className = v;
        else node.setAttribute(k, v === true ? '' : v);
      });
      (children || []).forEach(function (c) {
        if (c == null || c === false) return;
        node.appendChild(typeof c === 'string' ? document.createTextNode(c) : c);
      });
      return node;
    }
    function plural(n, one, many) { return n + ' ' + (n === 1 ? one : many); }
    function pct(n, d) { return d ? Math.round((n / d) * 100) : 0; }
    function mealLabel(v) {
      if (!v) return '';
      var m = MEALS.filter(function (x) { return x.value === v; })[0];
      return m ? m.label : v;
    }
    function fmtDate(iso, withTime) {
      var d = new Date(iso);
      if (isNaN(d)) return '';
      return d.toLocaleString(undefined, withTime === false ? { month: 'short', day: 'numeric' } : { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
    }

    /* ── Dietary needs: group free text into categories ─────────────── */
    var DIET_GROUPS = [
      { key: 'nuts', label: 'Nut allergy', allergen: true, re: /\b(tree ?nuts?|nuts?|peanuts?|almonds?|cashews?|walnuts?|pecans?|pistachios?|hazelnuts?)\b/i },
      { key: 'shellfish', label: 'Shellfish / fish', allergen: true, re: /\b(shellfish|shrimp|prawns?|lobster|crab|clams?|oysters?|mussels?|scallops?|fish|seafood)\b/i },
      { key: 'gluten', label: 'Gluten-free / celiac', re: /\b(gluten|celiac|coeliac|wheat)\b/i },
      { key: 'dairy', label: 'Dairy-free / lactose', re: /\b(dairy|lactose|milk|cheese)\b/i },
      { key: 'egg', label: 'Egg', allergen: true, re: /\beggs?\b/i },
      { key: 'soy', label: 'Soy', allergen: true, re: /\bsoy\b/i },
      { key: 'vegan', label: 'Vegan', re: /\bvegan\b/i },
      { key: 'vegetarian', label: 'Vegetarian', re: /\b(vegetarian|veggie|no meat)\b/i },
      { key: 'pescatarian', label: 'Pescatarian', re: /\bpescatarian\b/i },
      { key: 'religious', label: 'Kosher / halal', re: /\b(kosher|halal)\b/i }
    ];
    var ALLERGY_RE = /\b(allerg\w*|anaphyla\w*|epi-?pen|severe)\b/i;
    var NONE_RE = /^(none|n\/?a|no|nope|nothing|nada|-+|no restrictions?|no allergies)\.?$/i;
    function dietInfo(text) {
      var t = String(text || '').trim();
      if (!t || NONE_RE.test(t)) return { text: '', groups: [], allergy: false };
      var groups = DIET_GROUPS.filter(function (g) { return g.re.test(t); }).map(function (g) { return g.key; });
      if (groups.indexOf('vegan') >= 0) groups = groups.filter(function (g) { return g !== 'vegetarian'; });
      if (!groups.length) groups = ['other'];
      return { text: t, groups: groups, allergy: ALLERGY_RE.test(t) };
    }
    function isAllergen(key) { return DIET_GROUPS.some(function (g) { return g.key === key && g.allergen; }); }
    function dietLabel(key) {
      if (key === 'other') return 'Other';
      var g = DIET_GROUPS.filter(function (x) { return x.key === key; })[0];
      return g ? g.label : key;
    }

    /* ── Songs: combine the same request typed differently ──────────── */
    // "Mr. Brightside - The Killers" → "mr brightside" (drops an artist after a dash).
    function songKey(s) {
      return norm(s).replace(/[“”"'’.,!?()[\]]/g, '').split(/\s+[-–—]\s+/)[0].replace(/^the /, '').replace(/\s+/g, ' ').trim();
    }

    /* ── Sign-in (reuses the editor's GitHub sign-in) ───────────────── */
    function getToken() {
      try {
        var u = JSON.parse(localStorage.getItem('sveltia-cms.user') || 'null');
        if (u && u.token && (!u.backendName || u.backendName === 'github')) return u.token;
      } catch (e) { /* ignore */ }
      try { return sessionStorage.getItem(DASH_TOKEN_KEY) || ''; } catch (e) { return ''; }
    }
    function signIn() {
      var popup = window.open('https://api.netlify.com/auth?provider=github&site_id=' + encodeURIComponent(location.hostname) + '&scope=repo',
        'rsvp-dashboard-signin', 'width=960,height=640');
      if (!popup) { showError('Allow pop-ups', 'Your browser blocked the sign-in window. Allow pop-ups for this site and try again.'); return; }
      function onMessage(e) {
        if (e.origin !== 'https://api.netlify.com' || typeof e.data !== 'string') return;
        if (e.data === 'authorizing:github') { popup.postMessage(e.data, e.origin); return; }
        var m = /^authorization:github:(success|error):(.*)$/.exec(e.data);
        if (!m) return;
        window.removeEventListener('message', onMessage);
        try { popup.close(); } catch (err) { /* ignore */ }
        var info = {};
        try { info = JSON.parse(m[2]); } catch (err) { /* ignore */ }
        if (m[1] === 'success' && info.token) {
          try { sessionStorage.setItem(DASH_TOKEN_KEY, info.token); } catch (err) { /* ignore */ }
          load();
        } else {
          showError('Sign-in failed', (info && info.message) || 'GitHub sign-in did not complete. Please try again.');
        }
      }
      window.addEventListener('message', onMessage);
    }
    function show(which) { ['signin', 'error', 'dashboard'].forEach(function (id) { $(id).hidden = id !== which; }); }
    function showError(title, text) { $('error-title').textContent = title; $('error-text').textContent = text; $('meta').textContent = ''; show('error'); }

    function load() {
      var token = getToken();
      if (!token) { $('meta').textContent = ''; show('signin'); return; }
      $('refresh').disabled = true;
      document.body.classList.add('is-loading');
      if (!model) $('meta').textContent = 'Loading…';
      fetch(API, { headers: { Authorization: 'Bearer ' + token }, cache: 'no-store' })
        .then(function (res) { return res.json().catch(function () { return {}; }).then(function (body) { return { res: res, body: body }; }); })
        .then(function (r) {
          if (r.res.status === 401) {
            try { sessionStorage.removeItem(DASH_TOKEN_KEY); } catch (e) { /* ignore */ }
            $('meta').textContent = '';
            $('signin').querySelector('p').textContent = r.body.error || 'Your sign-in has expired. Sign in again.';
            show('signin');
            return;
          }
          if (!r.res.ok) { showError(r.body.setup ? 'Almost there' : 'Couldn’t load responses', r.body.error || ('The server answered ' + r.res.status + '.')); return; }
          payload = r.body;
          model = buildModel(r.body.submissions || []);
          fillFilterOptions();
          show('dashboard');
          render();
        })
        .catch(function () { showError('Couldn’t load responses', 'Check your connection and try again.'); })
        .then(function () { $('refresh').disabled = false; document.body.classList.remove('is-loading'); });
    }

    /* ── Model: invitations (each guest-list entry, plus unlisted replies)
          and the people on them, each with a status ─────────────────── */
    function partyFrom(d) {
      var party = [];
      for (var i = 1; i <= 50; i++) {
        var hasName = ('guest_' + i + '_name') in d, hasAtt = ('guest_' + i + '_attending') in d;
        if (!hasName && !hasAtt) { if (i > 1) break; else continue; }
        var name = String(d['guest_' + i + '_name'] || '').trim();
        if (name) party.push({ name: name, attending: d['guest_' + i + '_attending'] !== 'no', meal: d['guest_' + i + '_meal'] || '', afterparty: d['guest_' + i + '_afterparty'] || '' });
      }
      if (!party.length && d.guest_name && String(d.guest_name).trim()) party.push({ name: String(d.guest_name).trim(), attending: true, meal: d.guest_meal || '' });
      return party;
    }

    function buildModel(submissions) {
      var byId = {}, byName = {};
      GUESTS.forEach(function (g) { byId[String(g.id)] = g; byName[norm(g.name)] = g; });
      var replies = {};
      submissions.slice().sort(function (a, b) { return new Date(a.created_at) - new Date(b.created_at); }).forEach(function (s) {
        var d = s.data || {};
        var guest = byId[String(d.guest_id || '')] || byName[norm(d.name)] || null;
        var key = guest ? 'g:' + guest.id : 'u:' + (norm(d.email) || norm(d.name) || s.id);
        var prev = replies[key];
        replies[key] = { key: key, guest: guest, d: d, received: s.created_at, first: prev ? prev.first : s.created_at, updates: prev ? prev.updates + 1 : 0 };
      });
      var invitations = [];
      GUESTS.forEach(function (g) { invitations.push(makeInvitation(g, replies['g:' + g.id])); delete replies['g:' + g.id]; });
      Object.keys(replies).forEach(function (k) { invitations.push(makeInvitation(null, replies[k])); });
      var people = [];
      invitations.forEach(function (inv) { inv.people.forEach(function (p) { people.push(p); }); });
      return { invitations: invitations, people: people };
    }

    function makeInvitation(guest, reply) {
      var d = reply ? reply.d : {};
      var status = !reply ? 'awaiting' : (String(d.attending || '').toLowerCase() === 'yes' ? 'attending' : 'declined');
      var name = reply ? String(d.name || (guest && guest.name) || '(no name)') : guest.name;
      var inv = {
        id: guest ? 'g:' + guest.id : reply.key, guest: guest, onList: !!guest, name: name, status: status,
        email: String(d.email || ''), meal: status === 'attending' ? (d.meal || '') : '',
        afterparty: status === 'attending' ? (d.afterparty || '') : '',
        diet: dietInfo(d.dietary_restrictions), song: String(d.song_request || '').trim(),
        received: reply ? reply.received : '', first: reply ? reply.first : '', updates: reply ? reply.updates : 0,
        party: [], people: []
      };
      inv.people.push({ inv: inv, name: name, role: 'Guest', status: status, meal: inv.meal, afterparty: inv.afterparty });
      if (status === 'attending') {
        partyFrom(d).forEach(function (p) {
          var person = { inv: inv, name: p.name, role: 'Party', status: p.attending ? 'attending' : 'declined', meal: p.attending ? p.meal : '', afterparty: p.attending ? p.afterparty : '' };
          inv.party.push(person); inv.people.push(person);
        });
      } else {
        // Declined, or no reply yet: everyone on the invitation shares that status.
        ((guest && guest.party) || []).forEach(function (p) {
          var person = { inv: inv, name: p.name || 'Guest of their choice', role: 'Party', status: status, meal: '', afterparty: '' };
          inv.party.push(person); inv.people.push(person);
        });
      }
      inv.headcount = inv.people.filter(function (p) { return p.status === 'attending'; }).length;
      return inv;
    }

    /* ── Filtering: one slice drives every number, chart and table ──── */
    function personMatches(p, opts) {
      opts = opts || {};
      if (!opts.ignoreStatus && state.status && p.status !== state.status) return false;
      if (!opts.ignoreMeal && state.meal && (p.status !== 'attending' || (p.meal || '__none') !== state.meal)) return false;
      if (!opts.ignoreDiet && state.diet && p.inv.diet.groups.indexOf(state.diet) < 0) return false;
      if (!opts.ignoreAp && state.ap && (p.status !== 'attending' || (p.afterparty || '__none') !== state.ap)) return false;
      if (state.q) {
        var inv = p.inv;
        var hay = [inv.name, inv.email, inv.diet.text, inv.song, mealLabel(p.meal)].concat(inv.people.map(function (x) { return x.name; })).join(' ');
        if (norm(hay).indexOf(state.q) < 0) return false;
      }
      return true;
    }
    function slice(opts) {
      var people = model.people.filter(function (p) { return personMatches(p, opts); });
      var invs = [];
      people.forEach(function (p) { if (invs.indexOf(p.inv) < 0) invs.push(p.inv); });
      return { people: people, invitations: invs };
    }
    function count(people, status) { return people.filter(function (p) { return p.status === status; }).length; }

    /* ── Rendering ─────────────────────────────────────────────────── */
    function render() {
      var s = slice();
      view = s;
      var filtered = !!(state.status || state.meal || state.diet || state.ap || state.q);
      var onListInvs = s.invitations.filter(function (i) { return i.onList; });
      var onListAnswered = onListInvs.filter(function (i) { return i.status !== 'awaiting'; });
      var unlisted = s.invitations.filter(function (i) { return !i.onList; }).length;

      $('s-attending').textContent = count(s.people, 'attending');
      $('s-attending-sub').textContent = plural(s.invitations.filter(function (i) { return i.status === 'attending'; }).length, 'invitation', 'invitations') + ' accepted';
      $('s-declined').textContent = count(s.people, 'declined');
      $('s-declined-sub').textContent = 'people not coming';
      $('s-awaiting').textContent = count(s.people, 'awaiting');
      $('s-awaiting-sub').textContent = plural(s.invitations.filter(function (i) { return i.status === 'awaiting'; }).length, 'invitation', 'invitations');
      var rate = pct(onListAnswered.length, onListInvs.length);
      var attendingPeople = s.people.filter(function (p) { return p.status === 'attending'; });
      var apYes = attendingPeople.filter(function (p) { return p.afterparty === 'yes'; }).length;
      var apMaybe = attendingPeople.filter(function (p) { return p.afterparty === 'maybe'; }).length;
      $('s-ap').textContent = apYes;
      $('s-ap-sub').textContent = 'joining' + (apMaybe ? ' · ' + apMaybe + ' maybe' : '');
      $('s-rate').textContent = rate + '%';
      $('s-rate-sub').textContent = onListAnswered.length + ' of ' + onListInvs.length + ' invitations' + (unlisted ? ' · +' + unlisted + ' not on list' : '');
      $('s-rate-bar').style.width = rate + '%';

      renderStatus(slice({ ignoreStatus: true }).people);
      renderTimeline(s.invitations);
      renderMeals();
      renderAfterParty();
      renderDiet();
      renderSongs(s.invitations);
      renderWaiting(s.invitations);
      renderTable(s.invitations);

      document.querySelectorAll('#f-status button').forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.status === state.status)); });
      $('f-meal').value = state.meal; $('f-diet').value = state.diet;
      $('f-clear').hidden = !filtered;
      var parts = [];
      if (state.status) parts.push(STATUS[state.status].label);
      if (state.meal) parts.push(state.meal === '__none' ? 'No meal chosen' : mealLabel(state.meal));
      if (state.diet) parts.push(dietLabel(state.diet));
      if (state.ap) parts.push('After party: ' + apLabel(state.ap));
      if (state.q) parts.push('“' + $('f-search').value.trim() + '”');
      $('active-filters').textContent = filtered ? 'Showing ' + plural(s.people.length, 'person', 'people') + ' matching: ' + parts.join(' · ') : '';

      var subs = (payload.submissions || []).length;
      $('meta').textContent = plural(subs, 'submission', 'submissions') + ' · updated ' + fmtDate(payload.fetchedAt) + (payload.viewer ? ' · signed in as ' + payload.viewer : '');
      $('xlsx').disabled = $('csv').disabled = !s.people.length;
    }

    function setFilter(key, value) { state[key] = state[key] === value ? '' : value; render(); }

    function renderStatus(people) {
      var total = people.length;
      var stack = $('status-stack'), legend = $('status-legend');
      stack.textContent = ''; legend.textContent = '';
      $('status-count').textContent = plural(total, 'person', 'people');
      ['attending', 'declined', 'awaiting'].forEach(function (k) {
        var n = count(people, k);
        if (n) {
          var seg = el('button', { type: 'button', 'aria-pressed': String(state.status === k), 'aria-label': STATUS[k].label + ': ' + n + ' (' + pct(n, total) + '%)',
            style: 'flex:' + n + ' 1 0;background:' + STATUS[k].color + (state.status && state.status !== k ? ';opacity:.3' : '') });
          seg.addEventListener('click', function () { setFilter('status', k); });
          tipOn(seg, function () { return [String(n), STATUS[k].label + ' · ' + pct(n, total) + '% of people']; });
          stack.appendChild(seg);
        }
        legend.appendChild(el('li', {}, [el('span', { className: 'key', style: 'background:' + STATUS[k].color }), el('span', { text: STATUS[k].label }), el('strong', { text: n + ' (' + pct(n, total) + '%)' })]));
      });
      if (!total) stack.appendChild(el('span', { className: 'empty', text: 'No one matches these filters.' }));
    }

    function barList(container, items, opts) {
      container.textContent = '';
      container.classList.toggle('has-selection', !!opts.selected);
      if (!items.length) { container.appendChild(el('li', { className: 'empty', text: opts.empty })); return; }
      var max = Math.max.apply(null, items.map(function (i) { return i.value; }).concat([1]));
      items.forEach(function (it) {
        var btn = el('button', { type: 'button', className: 'bar', 'aria-pressed': String(opts.selected === it.key), 'aria-label': it.label + ': ' + it.value }, [
          el('span', { className: 'bl' }, [it.label, it.flag ? el('span', { className: 'flag', text: it.flag }) : null]),
          el('span', { className: 'track' }, [
            it.value ? el('span', { className: 'fill', style: 'width:calc((100% - 3em) * ' + (it.value / max).toFixed(4) + ')' }) : null,
            el('span', { className: 'val', text: String(it.value) })
          ])
        ]);
        btn.addEventListener('click', function () { opts.onClick(it); });
        tipOn(btn, function () { return it.tip; });
        container.appendChild(el('li', {}, [btn]));
      });
    }

    function renderMeals() {
      var people = slice({ ignoreMeal: true }).people.filter(function (p) { return p.status === 'attending'; });
      var counts = {};
      people.forEach(function (p) { var k = p.meal || '__none'; counts[k] = (counts[k] || 0) + 1; });
      var keys = MEALS.map(function (m) { return m.value; });
      Object.keys(counts).forEach(function (k) { if (k !== '__none' && keys.indexOf(k) < 0) keys.push(k); });
      if (counts.__none) keys.push('__none');
      var items = keys.map(function (k) {
        var n = counts[k] || 0, label = k === '__none' ? 'Not chosen yet' : mealLabel(k);
        return { key: k, label: label, value: n, tip: [String(n), label + ' · ' + pct(n, people.length) + '% of people attending'] };
      });
      barList($('meals'), people.length ? items : [], { selected: state.meal, empty: 'No one attending matches these filters yet.', onClick: function (it) { setFilter('meal', it.key); } });
    }

    function renderAfterParty() {
      var people = slice({ ignoreAp: true }).people.filter(function (p) { return p.status === 'attending'; });
      var counts = {};
      people.forEach(function (p) { var k = p.afterparty || '__none'; counts[k] = (counts[k] || 0) + 1; });
      var keys = ['yes', 'maybe', 'no'];
      Object.keys(counts).forEach(function (k) { if (k !== '__none' && keys.indexOf(k) < 0) keys.push(k); });
      if (counts.__none) keys.push('__none');
      var items = keys.map(function (k) {
        var n = counts[k] || 0, label = apLabel(k);
        return { key: k, label: label, value: n, tip: [String(n), label + ' · ' + pct(n, people.length) + '% of people attending'] };
      });
      barList($('afterparty'), people.length ? items : [], { selected: state.ap, empty: 'No one attending matches these filters yet.', onClick: function (it) { setFilter('ap', it.key); } });
    }

    function renderDiet() {
      var invs = slice({ ignoreDiet: true }).invitations.filter(function (i) { return i.diet.text; });
      var counts = {}, allergy = {};
      invs.forEach(function (i) { i.diet.groups.forEach(function (g) { counts[g] = (counts[g] || 0) + 1; if (i.diet.allergy && isAllergen(g)) allergy[g] = true; }); });
      var allergies = invs.filter(function (i) { return i.diet.allergy; }).length;
      $('diet-count').textContent = invs.length ? plural(invs.length, 'reply', 'replies') + ' with needs' + (allergies ? ' · ' + allergies + ' mention an allergy' : '') : '';
      var items = Object.keys(counts).sort(function (a, b) { return counts[b] - counts[a] || (a === 'other') - (b === 'other'); }).map(function (k) {
        var who = invs.filter(function (i) { return i.diet.groups.indexOf(k) >= 0; }).map(function (i) { return i.name; });
        return { key: k, label: dietLabel(k), value: counts[k], flag: allergy[k] ? 'allergy' : '', tip: [plural(counts[k], 'reply', 'replies'), dietLabel(k) + ': ' + who.slice(0, 4).join(', ') + (who.length > 4 ? ' +' + (who.length - 4) : '')] };
      });
      barList($('diet'), items, { selected: state.diet, empty: 'No dietary needs in these replies.', onClick: function (it) { setFilter('diet', it.key); } });
    }

    function songGroups(invs) {
      var groups = {};
      invs.forEach(function (i) {
        if (!i.song) return;
        var k = songKey(i.song);
        if (!groups[k]) groups[k] = { key: k, names: [], spellings: {} };
        groups[k].names.push(i.name);
        groups[k].spellings[i.song] = (groups[k].spellings[i.song] || 0) + 1;
      });
      // "mr brightside by the killers" joins "mr brightside" when both were requested.
      // (Only then, so a title like "Stand by Me" is never cut short.)
      Object.keys(groups).forEach(function (k) {
        var m = /^(.+?) by .+$/.exec(k);
        if (m && groups[m[1]] && groups[k]) {
          var into = groups[m[1]], from = groups[k];
          into.names = into.names.concat(from.names);
          Object.keys(from.spellings).forEach(function (sp) { into.spellings[sp] = (into.spellings[sp] || 0) + from.spellings[sp]; });
          delete groups[k];
        }
      });
      return Object.keys(groups).map(function (k) {
        var g = groups[k];
        // Most common spelling; on a tie, the longest (it usually names the artist).
        g.label = Object.keys(g.spellings).sort(function (a, b) { return g.spellings[b] - g.spellings[a] || b.length - a.length; })[0];
        return g;
      }).sort(function (a, b) { return b.names.length - a.names.length || a.label.localeCompare(b.label); });
    }

    function renderSongs(invs) {
      var list = songGroups(invs);
      var total = list.reduce(function (n, g) { return n + g.names.length; }, 0);
      $('songs-count').textContent = total ? plural(total, 'request', 'requests') + (list.length < total ? ' · ' + list.length + ' different' : '') : '';
      var items = list.slice(0, 12).map(function (g) {
        return { key: g.key, label: g.label, value: g.names.length, search: g.label,
          tip: [plural(g.names.length, 'request', 'requests'), 'from ' + g.names.slice(0, 5).join(', ') + (g.names.length > 5 ? ' +' + (g.names.length - 5) : '')] };
      });
      barList($('songs'), items, { empty: 'No song requests in these replies.', onClick: function (it) { $('f-search').value = it.search; state.q = norm(it.search); render(); } });
      if (list.length > 12) $('songs').appendChild(el('li', { className: 'small', style: 'padding:8px 4px 0', text: '+ ' + (list.length - 12) + ' more in the Excel download (Songs sheet)' }));
    }

    function renderWaiting(invs) {
      var waiting = invs.filter(function (i) { return i.status === 'awaiting'; });
      var w = $('waiting'); w.textContent = '';
      var people = waiting.reduce(function (n, i) { return n + i.people.length; }, 0);
      $('waiting-count').textContent = waiting.length ? plural(waiting.length, 'invitation', 'invitations') + ' · ' + plural(people, 'person', 'people') : '';
      if (!waiting.length) {
        var anyWaiting = model.invitations.some(function (i) { return i.status === 'awaiting'; });
        w.appendChild(el('li', { className: 'empty', text: anyWaiting ? 'No one matching these filters is waiting.' : 'Everyone on the guest list has replied. 🎉' }));
      }
      waiting.forEach(function (i) {
        w.appendChild(el('li', {}, [el('span', { className: 'name', text: i.name }), i.party.length ? el('div', { className: 'small', text: '+ ' + i.party.map(function (p) { return p.name; }).join(', ') }) : null]));
      });
    }

    function renderTable(invs) {
      var dir = state.dir === 'asc' ? 1 : -1;
      var order = { attending: 0, declined: 1, awaiting: 2 };
      var rows = invs.slice().sort(function (a, b) {
        var r = 0;
        if (state.sort === 'name') r = a.name.localeCompare(b.name);
        else if (state.sort === 'status') r = order[a.status] - order[b.status];
        else if (state.sort === 'meal') r = mealLabel(a.meal).localeCompare(mealLabel(b.meal));
        else r = (a.received ? new Date(a.received).getTime() : 0) - (b.received ? new Date(b.received).getTime() : 0);
        return r * dir || a.name.localeCompare(b.name);
      });
      document.querySelectorAll('th button').forEach(function (b) { b.dataset.dir = b.dataset.sort === state.sort ? state.dir : ''; });
      var body = $('rows'); body.textContent = '';
      $('table-count').textContent = plural(rows.length, 'invitation', 'invitations');
      rows.forEach(function (i) {
        var st = STATUS[i.status];
        var notes = [];
        if (i.diet.text) notes.push(el('div', {}, [el('span', { className: 'label', text: 'Diet ' }), i.diet.text, i.diet.allergy ? el('span', { className: 'flag', text: 'allergy' }) : null]));
        if (i.song) notes.push(el('div', {}, [el('span', { className: 'label', text: 'Song ' }), i.song]));
        body.appendChild(el('tr', {}, [
          el('td', {}, [
            el('div', { className: 'name', text: i.name }),
            i.email ? el('div', { className: 'small' }, [el('a', { href: 'mailto:' + i.email, text: i.email })]) : null,
            !i.onList ? el('div', {}, [el('span', { className: 'pill pill--warn', text: 'Not on guest list' })]) : null,
            i.updates ? el('div', { className: 'small', text: 'Updated ' + plural(i.updates, 'time', 'times') }) : null
          ]),
          el('td', {}, [el('span', { className: 'pill' }, [el('span', { className: 'key', style: 'background:' + st.color }), st.label]),
            el('div', { className: 'small', text: i.status === 'attending' ? plural(i.headcount, 'person', 'people') : plural(i.people.length, 'person', 'people') }),
            i.status === 'attending' ? el('div', { className: 'small', text: 'After party: ' + apLabel(i.afterparty) }) : null]),
          el('td', {}, [i.party.length ? el('ul', { className: 'party' }, i.party.map(function (p) {
            var cls = p.status === 'declined' ? 'no' : (p.status === 'awaiting' ? 'wait' : '');
            return el('li', { className: cls, text: p.name + (p.status === 'attending' && p.meal ? ' — ' + mealLabel(p.meal) : '') + (p.status === 'attending' ? ' · After party: ' + apLabel(p.afterparty) : '') + (p.status === 'declined' && i.status === 'attending' ? ' (not coming)' : '') });
          })) : el('span', { className: 'small', text: '—' })]),
          el('td', { text: i.status === 'attending' ? (mealLabel(i.meal) || 'Not chosen') : '—' }),
          el('td', {}, notes.length ? notes : [el('span', { className: 'small', text: '—' })]),
          el('td', { className: 'small tabular', text: i.received ? fmtDate(i.received) : '—' })
        ]));
      });
      $('rows-empty').hidden = rows.length > 0;
      $('rows-empty').textContent = 'No invitations match these filters.';
    }

    /* ── Timeline: invitations answered, cumulative by day ──────────── */
    function renderTimeline(invs) {
      var box = $('timeline'); box.textContent = '';
      var listed = invs.filter(function (i) { return i.onList; });
      if (listed.length) invs = listed;   // match the response rate: invitations on the guest list
      var total = invs.length;
      var answered = invs.filter(function (i) { return i.first; }).map(function (i) { return new Date(i.first); }).sort(function (a, b) { return a - b; });
      if (!answered.length) { box.appendChild(el('p', { className: 'empty', text: 'No replies yet in this view.' })); return; }
      var day = function (d) { var x = new Date(d); x.setHours(0, 0, 0, 0); return x; };
      var today = day(new Date());
      var start = day(answered[0]); start.setDate(start.getDate() - 1);
      var end = new Date(today);
      var deadline = DATA.deadline ? day(DATA.deadline + 'T12:00:00') : null;
      if (deadline && deadline > end) end = deadline;
      if (end - start < 6 * 864e5) { end = new Date(start); end.setDate(end.getDate() + 7); }
      var points = [], n = 0, idx = 0;
      for (var d = new Date(start); d <= end && d <= today; d.setDate(d.getDate() + 1)) {
        while (idx < answered.length && day(answered[idx]) <= d) { n++; idx++; }
        points.push({ date: new Date(d), value: n });
      }
      // Draw at the card's real width so labels stay at their true size on phones.
      var W = Math.max(280, Math.round(box.clientWidth || 560)), H = 220, L = 36, R = 48, T = 16, B = 28;
      var x = function (dt) { return L + ((dt - start) / (end - start)) * (W - L - R); };
      var yMax = Math.max(total, n, 1);
      var y = function (v) { return T + (1 - v / yMax) * (H - T - B); };
      var NS = 'http://www.w3.org/2000/svg';
      var svg = document.createElementNS(NS, 'svg');
      svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H); svg.setAttribute('class', 'chart'); svg.setAttribute('role', 'img');
      svg.setAttribute('aria-label', n + ' of ' + total + ' invitations answered as of ' + fmtDate(points[points.length - 1].date, false));
      function s(tag, attrs, text) { var e = document.createElementNS(NS, tag); Object.keys(attrs).forEach(function (k) { e.setAttribute(k, attrs[k]); }); if (text != null) e.textContent = text; svg.appendChild(e); return e; }
      var step = yMax <= 6 ? 1 : yMax <= 20 ? 5 : yMax <= 50 ? 10 : 25;
      for (var v = 0; v <= yMax; v += step) {
        s('line', { x1: L, x2: W - R, y1: y(v), y2: y(v), class: 'grid' });
        s('text', { x: L - 8, y: y(v) + 4, 'text-anchor': 'end' }, String(v));
      }
      if (total) s('text', { x: W - R + 6, y: y(total) + 4 }, 'of ' + total);
      s('text', { x: x(start), y: H - 8, 'text-anchor': 'start' }, fmtDate(start, false));
      s('text', { x: x(end), y: H - 8, 'text-anchor': 'end' }, fmtDate(end, false));
      if (deadline) {
        s('line', { x1: x(deadline), x2: x(deadline), y1: T, y2: H - B, class: 'deadline' });
        s('text', { x: x(deadline) - 4, y: T + 10, 'text-anchor': 'end', style: 'fill:var(--deep-gold)' }, 'Reply-by');
      }
      var path = points.map(function (p, i) { return (i ? 'L' : 'M') + x(p.date).toFixed(1) + ' ' + y(p.value).toFixed(1); }).join(' ');
      var last = points[points.length - 1];
      s('path', { d: path + ' L' + x(last.date).toFixed(1) + ' ' + y(0) + ' L' + x(points[0].date).toFixed(1) + ' ' + y(0) + ' Z', class: 'area' });
      s('path', { d: path, class: 'line' });
      s('circle', { cx: x(last.date), cy: y(last.value), r: 4.5, class: 'dot' });
      s('text', { x: x(last.date) + 8, y: y(last.value) - 8, class: 'end-label' }, String(last.value));
      var cross = s('line', { x1: 0, x2: 0, y1: T, y2: H - B, class: 'cross', visibility: 'hidden' });
      var hit = s('rect', { x: L, y: T, width: W - L - R, height: H - T - B, fill: 'transparent', tabindex: '0', 'aria-label': 'Replies over time. Use the arrow keys to step through days.' });
      var focusIdx = points.length - 1;
      function showAt(i, cx, cy) {
        var p = points[i]; if (!p) return;
        cross.setAttribute('x1', x(p.date)); cross.setAttribute('x2', x(p.date)); cross.setAttribute('visibility', 'visible');
        var added = i ? p.value - points[i - 1].value : p.value;
        tipShow([p.value + ' of ' + total + ' answered', fmtDate(p.date, false) + (added ? ' · +' + added + ' that day' : '')], cx, cy);
      }
      function nearest(evt) {
        var r = svg.getBoundingClientRect();
        var px = (evt.clientX - r.left) * (W / r.width);
        var best = 0, bd = Infinity;
        points.forEach(function (p, i) { var dd = Math.abs(x(p.date) - px); if (dd < bd) { bd = dd; best = i; } });
        return best;
      }
      hit.addEventListener('pointermove', function (e) { focusIdx = nearest(e); showAt(focusIdx, e.clientX, e.clientY); });
      hit.addEventListener('pointerleave', function () { cross.setAttribute('visibility', 'hidden'); tipHide(); });
      hit.addEventListener('focus', function () { var r = svg.getBoundingClientRect(); showAt(focusIdx, r.left + (x(points[focusIdx].date) / W) * r.width, r.top + 20); });
      hit.addEventListener('blur', function () { cross.setAttribute('visibility', 'hidden'); tipHide(); });
      hit.addEventListener('keydown', function (e) {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        e.preventDefault();
        focusIdx = Math.max(0, Math.min(points.length - 1, focusIdx + (e.key === 'ArrowRight' ? 1 : -1)));
        var r = svg.getBoundingClientRect();
        showAt(focusIdx, r.left + (x(points[focusIdx].date) / W) * r.width, r.top + 20);
      });
      box.appendChild(svg);
    }

    /* ── Tooltip ───────────────────────────────────────────────────── */
    var tip = $('tip');
    function tipShow(lines, cx, cy) {
      tip.textContent = '';
      tip.appendChild(el('strong', { text: lines[0] }));
      if (lines[1]) tip.appendChild(el('span', { text: lines[1] }));
      tip.hidden = false;
      var w = tip.offsetWidth, h = tip.offsetHeight;
      tip.style.left = Math.min(window.innerWidth - w - 8, Math.max(8, cx + 14)) + 'px';
      tip.style.top = (cy - h - 12 < 8 ? cy + 16 : cy - h - 12) + 'px';
    }
    function tipHide() { tip.hidden = true; }
    function tipOn(node, linesFn) {
      node.addEventListener('pointermove', function (e) { tipShow(linesFn(), e.clientX, e.clientY); });
      node.addEventListener('pointerleave', tipHide);
      node.addEventListener('focus', function () { var r = node.getBoundingClientRect(); tipShow(linesFn(), r.left + r.width / 2, r.top); });
      node.addEventListener('blur', tipHide);
    }

    /* ── Filter controls ───────────────────────────────────────────── */
    function fillFilterOptions() {
      var meal = $('f-meal'), diet = $('f-diet');
      meal.textContent = ''; diet.textContent = '';
      meal.appendChild(el('option', { value: '', text: 'All meals' }));
      var mealKeys = MEALS.map(function (m) { return m.value; });
      model.people.forEach(function (p) { if (p.meal && mealKeys.indexOf(p.meal) < 0) mealKeys.push(p.meal); });
      mealKeys.forEach(function (k) { meal.appendChild(el('option', { value: k, text: mealLabel(k) })); });
      meal.appendChild(el('option', { value: '__none', text: 'Not chosen yet' }));
      diet.appendChild(el('option', { value: '', text: 'All' }));
      var used = {};
      model.invitations.forEach(function (i) { i.diet.groups.forEach(function (g) { used[g] = true; }); });
      DIET_GROUPS.map(function (g) { return g.key; }).concat(['other']).filter(function (k) { return used[k]; })
        .forEach(function (k) { diet.appendChild(el('option', { value: k, text: dietLabel(k) })); });
      if (state.diet && !used[state.diet]) state.diet = '';
    }

    document.querySelectorAll('#f-status button').forEach(function (b) {
      b.addEventListener('click', function () { state.status = b.dataset.status; render(); });
    });
    $('f-meal').addEventListener('change', function (e) { state.meal = e.target.value; render(); });
    $('f-diet').addEventListener('change', function (e) { state.diet = e.target.value; render(); });
    var searchTimer;
    $('f-search').addEventListener('input', function (e) { clearTimeout(searchTimer); searchTimer = setTimeout(function () { state.q = norm(e.target.value); render(); }, 150); });
    $('f-clear').addEventListener('click', function () { state.status = state.meal = state.diet = state.ap = state.q = ''; $('f-search').value = ''; render(); });
    document.querySelectorAll('th button').forEach(function (b) {
      b.addEventListener('click', function () {
        if (state.sort === b.dataset.sort) state.dir = state.dir === 'asc' ? 'desc' : 'asc';
        else { state.sort = b.dataset.sort; state.dir = b.dataset.sort === 'received' ? 'desc' : 'asc'; }
        render();
      });
    });

    /* ── Export (follows the current filters) ───────────────────────── */
    function filterSummary() {
      var parts = [];
      if (state.status) parts.push('Status: ' + STATUS[state.status].label);
      if (state.meal) parts.push('Meal: ' + (state.meal === '__none' ? 'Not chosen yet' : mealLabel(state.meal)));
      if (state.diet) parts.push('Dietary: ' + dietLabel(state.diet));
      if (state.ap) parts.push('After party: ' + apLabel(state.ap));
      if (state.q) parts.push('Search: ' + $('f-search').value.trim());
      return parts.length ? parts.join('; ') : '';
    }
    function peopleRows(people) {
      return people.map(function (p) {
        var i = p.inv;
        return {
          'Invitation': i.name, 'Person': p.name, 'Role': p.role === 'Guest' ? 'Invited guest' : 'Party member',
          'Status': STATUS[p.status].label, 'Meal': p.status === 'attending' ? (mealLabel(p.meal) || 'Not chosen') : '',
          'After party': p.status === 'attending' ? apLabel(p.afterparty) : '',
          'Dietary needs (whole invitation)': i.diet.text, 'Allergy mentioned': i.diet.allergy ? 'Yes' : '',
          'Email': i.email, 'Song request': p.role === 'Guest' ? i.song : '', 'Replied': i.received ? new Date(i.received) : '',
          'On guest list': i.onList ? 'Yes' : 'No'
        };
      });
    }
    function invitationRows(invs) {
      return invs.map(function (i) {
        return {
          'Invitation': i.name, 'Status': STATUS[i.status].label, 'People on invitation': i.people.length, 'Attending': i.headcount,
          'Party': i.party.map(function (p) { return p.name + (p.status === 'attending' ? (p.meal ? ' (' + mealLabel(p.meal) + ')' : '') : (p.status === 'declined' && i.status === 'attending' ? ' (not coming)' : '')); }).join('; '),
          'Meal': i.status === 'attending' ? (mealLabel(i.meal) || 'Not chosen') : '',
          'After party (joining)': i.people.filter(function (p) { return p.status === 'attending' && p.afterparty === 'yes'; }).length,
          'Email': i.email, 'Dietary needs': i.diet.text,
          'Dietary groups': i.diet.text ? i.diet.groups.map(dietLabel).join(', ') : '', 'Allergy mentioned': i.diet.allergy ? 'Yes' : '',
          'Song request': i.song, 'Replied': i.received ? new Date(i.received) : '', 'Times updated': i.updates || '', 'On guest list': i.onList ? 'Yes' : 'No'
        };
      });
    }
    function summaryAoa(s) {
      var aoa = [
        ['RSVP Responses — ' + document.title.replace('RSVP Responses | ', '')],
        ['Exported', new Date()], ['Filters', filterSummary() || 'None (everyone)'], [],
        ['Totals', 'People'], ['Attending', count(s.people, 'attending')], ['Declined', count(s.people, 'declined')],
        ['Awaiting reply', count(s.people, 'awaiting')], ['Everyone in this view', s.people.length], [],
        ['Meals (people attending)', 'People']
      ];
      var mealCounts = {};
      s.people.forEach(function (p) { if (p.status === 'attending') { var k = mealLabel(p.meal) || 'Not chosen yet'; mealCounts[k] = (mealCounts[k] || 0) + 1; } });
      MEALS.forEach(function (m) { aoa.push([m.label, mealCounts[m.label] || 0]); delete mealCounts[m.label]; });
      Object.keys(mealCounts).forEach(function (k) { aoa.push([k, mealCounts[k]]); });
      aoa.push([], ['After party (people attending)', 'People']);
      var apCounts = {};
      s.people.forEach(function (p) { if (p.status === 'attending') { var k = p.afterparty || '__none'; apCounts[k] = (apCounts[k] || 0) + 1; } });
      ['yes', 'maybe', 'no', '__none'].forEach(function (k) { aoa.push([apLabel(k), apCounts[k] || 0]); delete apCounts[k]; });
      Object.keys(apCounts).forEach(function (k) { aoa.push([apLabel(k), apCounts[k]]); });
      aoa.push([], ['Dietary groups', 'Replies']);
      var dg = {};
      s.invitations.forEach(function (i) { if (i.diet.text) i.diet.groups.forEach(function (g) { dg[g] = (dg[g] || 0) + 1; }); });
      var dk = Object.keys(dg).sort(function (a, b) { return dg[b] - dg[a]; });
      dk.forEach(function (g) { aoa.push([dietLabel(g), dg[g]]); });
      if (!dk.length) aoa.push(['None so far', 0]);
      aoa.push([], ['Top song requests', 'Requests']);
      var songs = songGroups(s.invitations);
      songs.slice(0, 10).forEach(function (g) { aoa.push([g.label, g.names.length]); });
      if (!songs.length) aoa.push(['None so far', 0]);
      return aoa;
    }
    function fileStem() { return 'rsvps-' + new Date().toISOString().slice(0, 10) + (filterSummary() ? '-filtered' : ''); }

    var xlsxPromise = null;
    function loadXlsx() {
      if (window.XLSX) return Promise.resolve(window.XLSX);
      if (!xlsxPromise) xlsxPromise = new Promise(function (resolve, reject) {
        var sc = document.createElement('script');
        sc.src = DATA.xlsxUrl; sc.integrity = DATA.xlsxIntegrity; sc.crossOrigin = 'anonymous'; sc.referrerPolicy = 'no-referrer';
        sc.onload = function () { resolve(window.XLSX); };
        sc.onerror = function () { xlsxPromise = null; reject(new Error('load')); };
        document.head.appendChild(sc);
      });
      return xlsxPromise;
    }
    function sheetFrom(XLSX, rows, widths, header) {
      var ws = rows.length ? XLSX.utils.json_to_sheet(rows, { cellDates: true }) : XLSX.utils.aoa_to_sheet([header]);
      ws['!cols'] = widths.map(function (w) { return { wch: w }; });
      if (rows.length) ws['!autofilter'] = { ref: ws['!ref'] };
      Object.keys(ws).forEach(function (addr) { var c = ws[addr]; if (c && c.t === 'd') c.z = 'mmm d, yyyy h:mm AM/PM'; });
      return ws;
    }
    function buildWorkbook(XLSX) {
      var s = view;
      var wb = XLSX.utils.book_new();
      var sum = XLSX.utils.aoa_to_sheet(summaryAoa(s), { cellDates: true });
      sum['!cols'] = [{ wch: 38 }, { wch: 22 }];
      if (sum.B2) sum.B2.z = 'mmm d, yyyy h:mm AM/PM';
      XLSX.utils.book_append_sheet(wb, sum, 'Summary');
      XLSX.utils.book_append_sheet(wb, sheetFrom(XLSX, peopleRows(s.people), [24, 24, 14, 12, 18, 14, 36, 10, 28, 28, 20, 12], ['Person']), 'People');
      XLSX.utils.book_append_sheet(wb, sheetFrom(XLSX, invitationRows(s.invitations), [24, 12, 10, 10, 44, 18, 12, 28, 36, 24, 10, 28, 20, 8, 12], ['Invitation']), 'Invitations');
      var waiting = s.invitations.filter(function (i) { return i.status === 'awaiting'; }).map(function (i) { return { 'Invitation': i.name, 'People': i.people.map(function (p) { return p.name; }).join(', '), 'Count': i.people.length }; });
      XLSX.utils.book_append_sheet(wb, sheetFrom(XLSX, waiting, [26, 60, 8], ['Invitation', 'People', 'Count']), 'Not replied');
      var diet = s.invitations.filter(function (i) { return i.diet.text; }).map(function (i) { return { 'Invitation': i.name, 'Dietary needs': i.diet.text, 'Groups': i.diet.groups.map(dietLabel).join(', '), 'Allergy mentioned': i.diet.allergy ? 'Yes' : '', 'Attending': i.headcount }; });
      XLSX.utils.book_append_sheet(wb, sheetFrom(XLSX, diet, [26, 50, 28, 10, 10], ['Invitation', 'Dietary needs', 'Groups', 'Allergy mentioned', 'Attending']), 'Dietary');
      var songs = songGroups(s.invitations).map(function (g) { return { 'Song': g.label, 'Requests': g.names.length, 'Requested by': g.names.join(', ') }; });
      XLSX.utils.book_append_sheet(wb, sheetFrom(XLSX, songs, [40, 10, 60], ['Song', 'Requests', 'Requested by']), 'Songs');
      return wb;
    }
    function downloadXlsx() {
      var btn = $('xlsx'), label = btn.textContent;
      btn.disabled = true; btn.textContent = 'Preparing…';
      loadXlsx().then(function (XLSX) {
        XLSX.writeFile(buildWorkbook(XLSX), fileStem() + '.xlsx', { compression: true });
      }).catch(function () {
        alert('Couldn’t load the Excel tool. Check your connection, or use the CSV download instead.');
      }).then(function () { btn.disabled = false; btn.textContent = label; });
    }
    function downloadCsv() {
      var rows = peopleRows(view.people);
      var cols = rows.length ? Object.keys(rows[0]) : ['Person'];
      var csv = [cols].concat(rows.map(function (r) { return cols.map(function (c) { var v = r[c]; return v instanceof Date ? v.toISOString() : v; }); }))
        .map(function (line) {
          return line.map(function (v) {
            v = String(v == null ? '' : v);
            if (/^[=+\-@]/.test(v)) v = "'" + v; // keep spreadsheets from running text as a formula
            return /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v;
          }).join(',');
        }).join('\r\n');
      var a = el('a', { href: URL.createObjectURL(new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8' })), download: fileStem() + '.csv' });
      document.body.appendChild(a); a.click(); a.remove();
    }

    var resizeTimer, lastWidth = window.innerWidth;
    window.addEventListener('resize', function () {
      if (!model || window.innerWidth === lastWidth) return;
      lastWidth = window.innerWidth;
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () { renderTimeline(view.invitations); }, 150);
    });

    $('refresh').addEventListener('click', load);
    $('retry').addEventListener('click', load);
    $('signin-btn').addEventListener('click', signIn);
    $('signout').addEventListener('click', function () { try { sessionStorage.removeItem(DASH_TOKEN_KEY); } catch (e) { /* ignore */ } show('signin'); });
    $('xlsx').addEventListener('click', downloadXlsx);
    $('csv').addEventListener('click', downloadCsv);

    // For testing from the browser console.
    window.rsvpDashboard = { reload: load, state: state, view: function () { return view; }, dietInfo: dietInfo, songKey: songKey, buildWorkbook: buildWorkbook, loadXlsx: loadXlsx };
    load();
  })();
